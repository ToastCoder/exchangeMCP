{
  "name": "exchange-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Universal memory MCP server on Cloudflare Workers + D1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply exchange --local",
    "db:migrate:remote": "wrangler d1 migrations apply exchange --remote"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.167.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261123.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.2": true,
    "sharp@0.35.5": true,
    "fsevents": false
  }
}
